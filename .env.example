# Copy this file to .env and fill in real values. .env is in .gitignore: never commit it.

# PostgreSQL (RDS endpoint)
DB_HOST=your-db-endpoint.xxxxxx.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=airbreda
DB_USER=airbreda_admin
DB_PASSWORD=<your-db-secret>
DB_SSLMODE=require

# Object storage. Leave S3_BUCKET empty to save CSVs locally in ./data
S3_BUCKET=airbreda-favvy-raw
AWS_REGION=eu-north-1

# Luchtmeetnet station
LMN_STATION=NL10240

# NDW sites (optional: these are already the defaults in ingest_traffic.py)
# NDW_SITES=hrl=RWS01_MONIBAS_0271hrl0063ra,hrr=RWS01_MONIBAS_0271hrr0063ra,vwd=RWS01_MONIBAS_0270vwd0063ra,vwa=RWS01_MONIBAS_0270vwa0063ra

# Container 2: traffic-ingest (image name: airbreda-traffic)
# Build: docker build -t airbreda-traffic -f Dockerfile.traffic .
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY common.py ingest_traffic.py ./
# Runs once and exits. Cron on the VM starts it every hour.
CMD ["python", "ingest_traffic.py"]
